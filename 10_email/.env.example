# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-secure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,django

# --- Database ---
DATABASE_URL=postgres://user:password@db:5432/palestra_db

# --- Redis ---
