CHANNEL_LAYER_URL=redis://redis:6379/1

# --- Email (livello 10) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@palestra.local
INBOUND_EMAIL_DOMAIN=palestra.local
